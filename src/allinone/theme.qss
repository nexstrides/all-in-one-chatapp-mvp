/* Colors are tokens written with a leading at-sign, defined per scheme in theme.py. Never hard-code a color here. */
QWidget { font-family: "Segoe UI Variable", "Segoe UI", sans-serif; font-size: 13px; }
QMainWindow, QDialog, SettingsPage { background: @bg; color: @text; }
QLabel { color: @text; background: transparent; }
QLabel#heading { font-size: 24px; font-weight: 600; color: @text; }
QLabel#hero { font-size: 36px; font-weight: 700; color: @text; padding: 14px; }
QLabel#welcomeText { color: @text2; font-size: 16px; padding: 4px; }
QLabel#muted { color: @muted; font-size: 12px; }
QFrame#sidebar { background: @rail; border-right: 1px solid @border; }

QListWidget { background: @surface; border: 1px solid @border; border-radius: 12px; outline: none; color: @text2; }
QListWidget::item { border-radius: 10px; padding: 6px; color: @text2; }
QListWidget::item:selected { background: @accent_soft; color: @accent_text; }
QListWidget::item:hover { background: @hover; }
QListWidget#serviceRail { background: transparent; border: none; border-radius: 0; }
QListWidget#serviceRail::item { padding: 0 6px; border: 2px solid transparent; border-radius: 16px; }
QListWidget#serviceRail::item:hover { background: @hover; }
QListWidget#serviceRail::item:selected { background: @accent_soft; border-color: @accent; }
QListWidget#serviceRail::item:focus { border: 2px solid @focus; }

QPushButton { border: 1px solid @input_border; border-radius: 10px; padding: 9px 16px; background: @surface; color: @text2; }
QPushButton:hover { background: @hover; border-color: @accent; }
QPushButton:pressed { background: @accent_soft; }
QPushButton:checked { background: @accent_soft; border-color: @accent; }
QPushButton:focus { border: 2px solid @focus; }
QPushButton:disabled { color: @disabled_text; background: @disabled_bg; border-color: @border; }
QPushButton#iconButton { padding: 6px; border: 1px solid transparent; background: transparent; border-radius: 16px; }
QPushButton#iconButton:checked { background: @accent_soft; border-color: @accent; }
QPushButton#iconButton:focus { border: 2px solid @focus; }
QPushButton#addService { padding: 6px; border: 1px dashed @input_border; background: transparent; border-radius: 16px; }
QPushButton#addService:focus { border: 2px solid @focus; }
QPushButton#primary { background: @btn_bg; color: @on_accent; border: none; font-weight: 600; padding: 12px 22px; }
QPushButton#primary:hover { background: @btn_hover; }

QLabel#notificationBadge { background: @danger; color: @on_accent; border-radius: 10px; font-size: 10px; font-weight: 700; }
QLabel#statusNotice { background: @notice_bg; color: @notice_text; border: 1px solid @notice_border; border-radius: 10px; padding: 8px; }

QLineEdit, QComboBox, QSpinBox { background: @input_bg; color: @text; border: 1px solid @input_border; border-radius: 8px; padding: 8px; min-height: 20px; selection-background-color: @accent; selection-color: @on_accent; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid @focus; }
QComboBox QAbstractItemView { background: @surface; color: @text; border: 1px solid @border; selection-background-color: @accent_soft; selection-color: @accent_text; outline: none; }
QCheckBox { color: @text2; spacing: 8px; padding: 6px 0; }

QMenu { background: @surface; color: @text2; border: 1px solid @border; border-radius: 10px; padding: 6px; }
QMenu::item { padding: 8px 22px; border-radius: 6px; }
QMenu::item:selected { background: @accent_soft; color: @accent_text; }
QMenu::item:disabled { color: @disabled_text; }
QMenu::separator { height: 1px; background: @border; margin: 6px 8px; }
QToolTip { background: @tip_bg; color: @tip_text; padding: 6px 8px; border: none; }

QScrollBar:vertical { background: transparent; width: 6px; margin: 0; }
QScrollBar::handle:vertical { background: @scroll; border-radius: 3px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: @muted; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
