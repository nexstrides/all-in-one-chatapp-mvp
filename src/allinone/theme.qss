QMainWindow, QDialog, SettingsPage { background: #f8f9fc; color: #272337; }
QWidget { font-family: "Segoe UI", sans-serif; font-size: 13px; }
QFrame#sidebar { background: #f1edf8; border-right: 1px solid #e1dbe9; }
QLabel#heading { font-size: 24px; font-weight: 600; color: #342a48; }
QLabel#hero { font-size: 36px; font-weight: 700; color: #342a48; padding: 14px; }
QLabel#welcomeText { color: #6b6379; font-size: 16px; padding: 4px; }
QLabel#muted { color: #766e83; font-size: 12px; }
QListWidget { background: white; border: 1px solid #e2ddea; border-radius: 10px; outline: none; }
QListWidget::item { border-radius: 9px; padding: 6px; color: #514961; }
QListWidget::item:selected { background: #e3d9f6; color: #553997; }
QListWidget::item:hover { background: #eee8f7; }
QListWidget#serviceRail { background: transparent; border: none; border-radius: 0; }
QListWidget#serviceRail::item { padding: 0 6px; border: 2px solid transparent; }
QListWidget#serviceRail::item:selected { background: #ded2f3; border-color: #8661c3; }
QListWidget#serviceRail::item:focus { border: 2px solid #62449b; }
QPushButton { border: 1px solid #ded8e8; border-radius: 8px; padding: 9px 14px;
    background: #ffffff; color: #514961; }
QPushButton:hover { background: #eee8f8; border-color: #b9a5df; }
QPushButton:checked { background: #dcccf5; border-color: #9f80ce; }
QPushButton:focus { border: 2px solid #8463d0; }
QPushButton:disabled { color: #aaa3b4; background: #f3f1f6; }
QPushButton#iconButton { padding: 6px; border: 1px solid transparent; background: transparent; border-radius: 14px; }
QPushButton#iconButton:hover { background: #e3daef; }
QPushButton#iconButton:checked { background: #dcccf5; border-color: #a88bcf; }
QPushButton#iconButton:focus { border: 2px solid #8463d0; }
QPushButton#addService { padding: 6px; border: 1px dashed #c1b3d8; background: transparent; border-radius: 14px; }
QPushButton#addService:hover { background: #e3daef; border: 1px solid #8463d0; }
QPushButton#primary { background: #7350b5; color: white; border: none; font-weight: 600; padding: 12px 20px; }
QPushButton#primary:hover { background: #62409e; }
QLabel#notificationBadge { background: #dc354f; color: white; border-radius: 10px; font-size: 10px; font-weight: 700; }
QLabel#statusNotice { background: #fff5db; color: #654f1c; border: 1px solid #ecd69f; border-radius: 8px; padding: 8px; }
QLineEdit, QComboBox, QSpinBox { background: white; color: #272337; border: 1px solid #d8d2e4; border-radius: 6px; padding: 8px; min-height: 20px; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #8463d0; }
QCheckBox { color: #514961; spacing: 8px; padding: 6px 0; }
QMenu { background: white; color: #514961; border: 1px solid #ded8e8; padding: 6px; }
QMenu::item { padding: 8px 20px; border-radius: 5px; }
QMenu::item:selected { background: #e8e0f4; }
QToolTip { background: #342a48; color: white; padding: 6px; border: none; }
QScrollBar:vertical { background: transparent; width: 5px; margin: 0; }
QScrollBar::handle:vertical { background: #c1b3d8; border-radius: 2px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
